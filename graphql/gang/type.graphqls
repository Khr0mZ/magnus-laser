type Gang {
  ID: ID!
  name: String!
  description: String!
  type: GangType!
  cyberwareQuality: CyberwareQuality!
  skill: Int!
  weapons: Dices!
  armor: Armor!
  secretive: Int!
  status: GangStatus!
  color: GangColor!
  sin: Sin!
  knownFor: KnownFor!
  flaw: Flaw!
  currentAttitude: Attitude!
  newsTheLeaderIsReceiving: GangNews!
}

type Armor {
  spb: Int!
  h: Int!
}

type KnownFor {
  knownForPart1: KnownForPart1!
  knownForPart2: KnownForPart2!
}
