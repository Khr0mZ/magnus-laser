type Building {
  ID: ID!
  name: String!
  description: String!
  type: BuildingType!
  elevators: Boolean!
  parking: Boolean!
  gatehouseFrontDesk: Boolean!
  emergencyExit: Boolean!
  backupLights: Boolean!
  landingPad: Boolean!
  secretOrAltEntrance: Boolean!
  ownership: BuildingOwnership!
  securityPersonnel: BuildingSecurityPersonnel!
  style: BuildingStyle!
  event: BuildingEvent!
  secret: BuildingSecret!
  isAbandoned: Boolean!
  image: String!
}
