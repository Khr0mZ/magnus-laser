type Building {
  ID: ID!
  generatedName: String!
  type: BuildingType!
  elevators: Boolean!
  parking: Boolean!
  gatehouseFrontDesk: Boolean!
  emergencyExit: Boolean!
  backupLights: Boolean!
  landingPad: Boolean!
  secretOrAltEntrance: Boolean!
  ownership: Ownership!
  securityPersonnel: SecurityPersonnel!
  style: Style!
  event: Event!
  secret: Secret!
}
