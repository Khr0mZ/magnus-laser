{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "magnus-laser",
    "version": "0.2.7",
    "identifier": "com.magnus-laser",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "Magnus Laser",
                "width": 1280,
                "height": 800,
                "minWidth": 1024,
                "minHeight": 768,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-eval' 'unsafe-inline'; connect-src 'self' data: http: https: ws: wss:;"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "../public/magnusLaserLogo.png",
            "../public/magnusLaserLogoFav.png",
            "../public/magnusLaserLogoFav.ico"
        ],
        "externalBin": []
    },
    "plugins": {
        "fs": {
            "scope": ["**"]
        },
        "shell": {
            "open": true
        }
    }
}
