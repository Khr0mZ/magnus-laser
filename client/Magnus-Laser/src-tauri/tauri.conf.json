{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "magnus-laser",
    "version": "0.1.0",
    "identifier": "com.magnus-laser.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "magnus-laser",
                "width": 1280,
                "height": 800,
                "minWidth": 1024,
                "minHeight": 768,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; connect-src 'self' https:;"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
    },
    "plugins": {
        "fs": {
            "scope": ["**"]
        },
        "shell": {
            "open": true
        }
    }
}
